# Settings for docker-compose.yml (copy to deploy.env).  Run:  docker compose --env-file deploy.env up -d --build

# --- Required: API credentials. Generate your own, do NOT keep these examples:
#     docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=changeme-key
LIVEKIT_API_SECRET=changeme-secret-at-least-32-characters-long

# --- What browsers connect to for calls.
#     Plain HTTP / localhost:   ws://localhost:7880      (or ws://SERVER_IP:7880; camera only works on localhost over HTTP)
#     With the https profile:   wss://your.domain.com
PUBLIC_LIVEKIT_URL=ws://localhost:7880

# --- Only for the https profile: your domain (its DNS must point at this server; ports 80 + 443 must be open)
# DOMAIN=your.domain.com

# --- Networking.
# true: LiveKit finds the server's public IP (needs outbound internet). Right for cloud servers.
# false + NODE_IP=<ip>: advertise a fixed address instead (LAN servers, or when behind NAT with a known IP).
USE_EXTERNAL_IP=true
# NODE_IP=

# --- Optional: change ports (defaults shown)
# APP_PORT=8100
# LK_PORT=7880
# LK_TCP_PORT=7881
# LK_UDP_PORT=7882
# REDIS_PORT=6379
# EGRESS_HEALTH_PORT=9090
# EGRESS_TEMPLATE_PORT=7980

# --- Optional: pin image versions instead of "latest"
# LIVEKIT_VERSION=v1.13.10
# EGRESS_VERSION=latest
